# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out-iphone/
/public/sql-wasm.wasm
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …sauf l'exemple, qui documente les variables sans contenir aucune clé.
!.env.local.exemple

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base locale et médias (données de travail, jamais versionnées)
/data/

# outils téléchargés (binaires et modèles de voix, ~260 Mo)
/outils/
